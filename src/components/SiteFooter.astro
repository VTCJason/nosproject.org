  <div class="container footer-bottom">
    <span class="label">nosmanifesto.org</span>
    <span class="label">© 2025 — All rights reserved</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: var(--ivory);
    border-top: 1px solid var(--steel);
    margin-top: 4rem;
  }
  .footer-inner {
    display: flex;
    gap: 4rem;
    padding-top: 3rem;
    padding-bottom: 2rem;
    flex-wrap: wrap;
  }
  .footer-brand {
    flex: 1;
    min-width: 200px;
  }
  .wordmark {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.04em;
  }
  .tagline {
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 0.5rem;
    max-width: 30ch;
    line-height: 1.55;
  }
  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-nav a {
    color: var(--cream);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-nav a:hover {
    color: var(--amber);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--slate);
    padding-top: 1rem;
    padding-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer-bottom .label {
    color: var(--muted);
    font-size: 0.7rem;
  }
</style>
