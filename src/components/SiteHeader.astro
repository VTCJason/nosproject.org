---
const nav = [
  { label: 'nOS', href: '/' },
  { label: 'Case Study', href: '/case-study/' },
  { label: 'The Human Question', href: '/human-question/' },
  { label: 'Glossary', href: '/glossary/' },
  { label: 'Essays', href: '/essays/' },
  { label: 'About', href: '/about/' },
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark">nOS</a>
    <nav aria-label="Main navigation">
      <ul class="nav-list">
        {nav.map(item => (
          <li>
            <a
              href={item.href}
              class:list={[
                'nav-link',
                {
                  active:
                    item.href === '/'
                      ? path === '/'
                      : path.startsWith(item.href),
                },
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="/sign/" class="cta-btn">Sign the Manifesto</a>
  </div>
</header>

<style>
  .site-header {
    background: var(--navy);
    border-bottom: 2px solid var(--gold);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-top: 0.875rem;
    padding-bottom: 0.875rem;
  }
  .wordmark {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }
  nav {
    flex: 1;
  }
  .nav-list {
    list-style: none;
    display: flex;
    gap: 0.125rem;
    flex-wrap: wrap;
  }
  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ivory);
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border-radius: 3px;
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover {
    color: var(--amber);
    background: rgba(255, 255, 255, 0.06);
  }
  .nav-link.active {
    color: var(--amber);
  }
  .cta-btn {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy);
    background: var(--gold);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 2px;
    font-weight: 700;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .cta-btn:hover {
    background: var(--amber);
  }

  @media (max-width: 820px) {
    .cta-btn {
      display: none;
    }
    .header-inner {
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    nav {
      width: 100%;
    }
    .nav-link {
      font-size: 0.8rem;
      padding: 0.25rem 0.5rem;
    }
  }
</style>
