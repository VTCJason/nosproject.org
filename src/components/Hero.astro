---
interface Props {
  eyebrow?: string;
  headline: string;
  subline?: string;
  cta?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  dark?: boolean;
}

const { eyebrow, headline, subline, cta, ctaSecondary, dark = false } =
  Astro.props;
---

<section class:list={['hero', { 'hero--dark': dark }]}>
  <div class="container hero-inner">
    {eyebrow && <p class="label hero-eyebrow">{eyebrow}</p>}
    <h1 class="hero-headline">{headline}</h1>
    {subline && <p class="hero-subline">{subline}</p>}
    {
      (cta || ctaSecondary) && (
        <div class="hero-actions">
          {cta && (
            <a href={cta.href} class="btn btn-primary">
              {cta.label}
            </a>
          )}
          {ctaSecondary && (
            <a href={ctaSecondary.href} class="btn btn-secondary">
              {ctaSecondary.label}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    background: var(--cream);
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--rule);
  }
  .hero--dark {
    background: var(--navy);
    border-bottom-color: var(--steel);
  }
  .hero--dark .hero-headline,
  .hero--dark .hero-subline {
    color: var(--ivory);
  }
  .hero--dark .hero-eyebrow {
    color: var(--amber);
  }
  .hero-eyebrow {
    margin-bottom: 1rem;
  }
  .hero-headline {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    color: var(--navy);
    line-height: 1.1;
  }
  .hero-subline {
    font-size: 1.125rem;
    color: var(--muted);
    margin-top: 1.25rem;
    line-height: 1.75;
  }
  .hero--dark .hero-subline {
    color: var(--cream);
    opacity: 0.9;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2.25rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: 2px;
    font-weight: 700;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .btn-primary {
    background: var(--gold);
    color: var(--navy);
  }
  .btn-primary:hover {
    background: var(--amber);
    color: var(--navy);
  }
  .btn-secondary {
    background: transparent;
    color: var(--navy);
    border: 1px solid var(--steel);
  }
  .btn-secondary:hover {
    background: var(--navy);
    color: var(--ivory);
    border-color: var(--navy);
  }
  .hero--dark .btn-secondary {
    color: var(--ivory);
    border-color: var(--steel);
  }
  .hero--dark .btn-secondary:hover {
    background: var(--slate);
  }
</style>
