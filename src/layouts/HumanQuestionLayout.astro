---
import BaseLayout from './BaseLayout.astro';
import TopicNav from '../components/TopicNav.astro';
import VerdictLegend from '../components/VerdictLegend.astro';

interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}

const { title, description, frontmatter } = Astro.props;
const resolvedTitle = frontmatter?.title ?? title ?? 'The Human Question';
const resolvedDesc = frontmatter?.description ?? description;
---

<BaseLayout title={resolvedTitle} description={resolvedDesc}>
  <div class="hq-layout">
    <div class="container hq-grid">
      <aside class="hq-sidebar">
        <TopicNav />
        <div class="sidebar-spacer"></div>
        <VerdictLegend />
      </aside>
      <div class="hq-content">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hq-layout {
    padding: 2.5rem 0 5rem;
    background: var(--ivory);
  }
  .hq-grid {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 3rem;
    align-items: start;
  }
  .hq-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .hq-content :global(h1) {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--navy);
    margin-bottom: 0.375rem;
    line-height: 1.2;
  }
  .hq-content :global(h2) {
    font-size: 1.25rem;
    color: var(--navy);
    margin: 2.5rem 0 1rem;
  }
  .hq-content :global(p) {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 1rem;
    max-width: none;
  }
  .hq-content :global(hr) {
    margin: 2rem 0;
  }
  .hq-content :global(.topic-header) {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .hq-content :global(.topic-lead) {
    font-size: 1.0625rem;
    color: var(--muted);
    line-height: 1.75;
    margin-top: 0.625rem;
    max-width: none;
  }
  .hq-content :global(.question-cards) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .hq-content :global(.content-grid) {
    display: grid;
    grid-template-columns: 1fr 230px;
    gap: 2rem;
    align-items: start;
  }
  .hq-content :global(.content-sidebar) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: sticky;
    top: calc(56px + 1.5rem);
  }

  @media (max-width: 900px) {
    .hq-content :global(.content-grid) {
      grid-template-columns: 1fr;
    }
    .hq-content :global(.content-sidebar) {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .hq-grid {
      grid-template-columns: 1fr;
    }
    .hq-sidebar {
      order: 2;
      margin-top: 2rem;
    }
    .hq-content {
      order: 1;
    }
  }
</style>
