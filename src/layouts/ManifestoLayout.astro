---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}

const { title, description, frontmatter } = Astro.props;
const resolvedTitle = frontmatter?.title ?? title ?? 'The nOS Manifesto';
const resolvedDesc = frontmatter?.description ?? description;
---

<BaseLayout title={resolvedTitle} description={resolvedDesc}>
  <div class="manifesto-wrap">
    <div class="container manifesto-inner">
      <article class="manifesto-body">
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .manifesto-wrap {
    background: var(--ivory);
    padding: 4rem 0 6rem;
  }
  .manifesto-inner {
    max-width: 740px;
  }
  .manifesto-body :global(h1) {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--navy);
    margin-bottom: 0.5rem;
    line-height: 1.1;
  }
  .manifesto-body :global(h1 + p em) {
    font-size: 1rem;
    color: var(--muted);
    font-style: italic;
  }
  .manifesto-body :global(h2) {
    font-size: 1.375rem;
    color: var(--navy);
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .manifesto-body :global(p) {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--text);
    margin-bottom: 1.25rem;
    max-width: none;
  }
  .manifesto-body :global(hr) {
    margin: 2.5rem 0;
  }
  .manifesto-body :global(blockquote) {
    border-left: 3px solid var(--gold);
    padding: 0.5rem 0 0.5rem 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--slate);
    font-size: 1.0625rem;
  }
  .manifesto-body :global(a) {
    color: var(--steel);
  }
</style>
