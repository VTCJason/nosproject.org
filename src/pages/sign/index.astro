---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sign the Manifesto"
  description="Add your name to the nOS Manifesto — a public declaration for the age of artificial intelligence."
>
  <div class="sign-hero">
    <div class="container">
      <p class="label eyebrow">Public Declaration</p>
      <h1 class="sign-headline">Sign the Manifesto</h1>
      <p class="sign-subline">
        Signing means you've read it, you believe it, and you're willing to put your name on it.
        This is a public record.
      </p>
    </div>
  </div>

  <section class="sign-body">
    <div class="container sign-grid">
      <div class="sign-form-wrap">

        <div id="form-notice" class="form-notice" style="display:none">
          <p class="label notice-label" id="notice-label">Signature collection</p>
          <p class="notice-text" id="notice-text"></p>
        </div>

        <div id="success-message" style="display:none" class="form-notice form-notice--success">
          <p class="label notice-label">You're on the list</p>
          <p class="notice-text">Thank you for signing the nOS Manifesto. Your name will appear on the signatories page once the list goes live.</p>
        </div>

        <form id="sign-form" class="sign-form">
          <div class="field-group">
            <label class="field-label" for="name">Full name</label>
            <input
              class="field-input"
              id="name"
              name="name"
              type="text"
              placeholder="Your name as it will appear"
              autocomplete="name"
              required
              maxlength="200"
            />
          </div>
          <div class="field-group">
            <label class="field-label" for="email">Email address</label>
            <input
              class="field-input"
              id="email"
              name="email"
              type="email"
              placeholder="For notification only — not published"
              autocomplete="email"
              required
            />
          </div>
          <div class="field-group">
            <label class="field-label" for="affiliation">
              Affiliation <span class="field-optional">(optional)</span>
            </label>
            <input
              class="field-input"
              id="affiliation"
              name="affiliation"
              type="text"
              placeholder="Organization, title, or role"
              maxlength="300"
            />
          </div>
          <div class="field-group">
            <label class="field-label" for="why">
              Why you're signing <span class="field-optional">(optional)</span>
            </label>
            <textarea
              class="field-input field-textarea"
              id="why"
              name="why"
              placeholder="A sentence or two — may be shared with your permission"
              maxlength="2000"
            ></textarea>
            <label class="field-checkbox-label">
              <input type="checkbox" id="share-reason" name="share-reason" />
              <span>Share my reason publicly</span>
            </label>
          </div>
          <button class="submit-btn" type="submit" id="submit-btn">Sign the Manifesto</button>
          <p id="form-error" class="form-error" style="display:none"></p>
        </form>
      </div>

      <aside class="sign-sidebar">
        <div class="sign-callout">
          <p class="label">Before you sign</p>
          <ul>
            <li>Read the full manifesto</li>
            <li>Understand that your name will be public</li>
            <li>Sign as an individual, not on behalf of an organization</li>
            <li>You can withdraw your signature at any time</li>
          </ul>
        </div>
        <div class="sign-callout">
          <p class="label">Already signed?</p>
          <p>View the list of current signatories at <a href="/signatories/">signatories</a>.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  const form = document.getElementById('sign-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formError = document.getElementById('form-error') as HTMLElement;
  const successMessage = document.getElementById('success-message') as HTMLElement;
  const formNotice = document.getElementById('form-notice') as HTMLElement;

  if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
    formNotice.style.display = 'block';
    (document.getElementById('notice-label') as HTMLElement).textContent = 'Configuration error';
    (document.getElementById('notice-text') as HTMLElement).textContent =
      'Signing is temporarily unavailable. Please try again later.';
    submitBtn.disabled = true;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.style.display = 'none';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const affiliation = (document.getElementById('affiliation') as HTMLInputElement).value.trim();
    const why = (document.getElementById('why') as HTMLTextAreaElement).value.trim();
    const shareReason = (document.getElementById('share-reason') as HTMLInputElement).checked;

    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/signatories`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
          'Prefer': 'return=minimal',
        },
        body: JSON.stringify({
          full_name: name,
          email: email,
          affiliation: affiliation || null,
          why_signing: why || null,
          share_reason: shareReason,
        }),
      });

      if (response.status === 409) {
        formError.textContent = 'This email address has already been used to sign the manifesto.';
        formError.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Sign the Manifesto';
        return;
      }

      if (!response.ok) {
        throw new Error(`Server error: ${response.status}`);
      }

      form.style.display = 'none';
      successMessage.style.display = 'block';

    } catch (err) {
      formError.textContent = 'Something went wrong. Please try again.';
      formError.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign the Manifesto';
    }
  });
</script>
