---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sign the Manifesto"
  description="Add your name to the nOS Manifesto — a public declaration for the age of artificial intelligence."
>
  <div class="sign-hero">
    <div class="container">
      <p class="label eyebrow">Public Declaration</p>
      <h1 class="sign-headline">Sign the Manifesto</h1>
      <p class="sign-subline">
        Signing means you've read it, you believe it, and you're willing to put your name on it.
        This is a public record.
      </p>
    </div>
  </div>

  <section class="sign-body">
    <div class="container sign-grid">
      <div class="sign-form-wrap">

        <div id="form-notice" class="form-notice" style="display:none">
          <p class="label notice-label" id="notice-label">Signature collection</p>
          <p class="notice-text" id="notice-text"></p>
        </div>

        <div id="success-message" style="display:none" class="form-notice form-notice--success">
          <p class="label notice-label">You're on the list</p>
          <p class="notice-text">Thank you for signing the nOS Manifesto. Your signature is now recorded and will appear on the signatories page.</p>
        </div>

        <form id="sign-form" class="sign-form">
          <div class="field-group">
            <label class="field-label" for="name">Full name</label>
            <input
              class="field-input"
              id="name"
              name="name"
              type="text"
              placeholder="Your name as it will appear"
              autocomplete="name"
              required
              maxlength="200"
            />
          </div>
          <div class="field-group">
            <label class="field-label" for="email">Email address</label>
            <input
              class="field-input"
              id="email"
              name="email"
              type="email"
              placeholder="For verification only — never published"
              autocomplete="email"
              required
            />
            <p class="field-hint">Your email address is collected for verification purposes only. It will never be published, shared, or sold.</p>
          </div>
          <div class="field-group">
            <label class="field-label" for="affiliation">
              Affiliation <span class="field-optional">(optional)</span>
            </label>
            <input
              class="field-input"
              id="affiliation"
              name="affiliation"
              type="text"
              placeholder="Organization, title, or role"
              maxlength="300"
            />
          </div>
          <div class="field-group">
            <label class="field-label" for="why">
              Why you're signing <span class="field-optional">(optional)</span>
            </label>
            <textarea
              class="field-input field-textarea"
              id="why"
              name="why"
              placeholder="A sentence or two — may be shared with your permission"
              maxlength="2000"
            ></textarea>
            <label class="field-checkbox-label">
              <input type="checkbox" id="share-reason" name="share-reason" />
              <span>Share my reason publicly</span>
            </label>
          </div>
          <div class="field-group">
            <label class="field-checkbox-label">
              <input type="checkbox" id="show-name" name="show-name" checked />
              <span>Display my name publicly on the signatories page</span>
            </label>
            <p class="field-hint">If unchecked, your signature is counted but listed as Anonymous.</p>
          </div>
          <button class="submit-btn" type="submit" id="submit-btn">Sign the Manifesto</button>
          <p id="form-error" class="form-error" style="display:none"></p>
          <p class="privacy-note">Your information is not sold or shared with third parties. <a href="/privacy/">Privacy policy</a>.</p>
        </form>
      </div>

      <aside class="sign-sidebar">
        <div class="sign-callout">
          <p class="label">Before you sign</p>
          <ul>
            <li>Read the full manifesto</li>
            <li>Your name will appear publicly unless you choose anonymous</li>
            <li>Sign as an individual, not on behalf of an organization</li>
          </ul>
        </div>
        <div class="sign-callout">
          <p class="label">Already signed?</p>
          <p>View the list of current signatories at <a href="/signatories/">signatories</a>.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .sign-hero {
    background: var(--navy);
    border-bottom: 2px solid var(--gold);
    padding: 3.5rem 0 3rem;
  }
  .eyebrow { color: var(--amber); margin-bottom: 0.75rem; }
  .sign-headline {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--ivory);
    line-height: 1.15;
    margin-bottom: 1rem;
  }
  .sign-subline {
    font-size: 1.0625rem;
    color: var(--cream);
    max-width: 52ch;
    line-height: 1.7;
    opacity: 0.9;
  }

  /* ── Body layout ────────────────────────────────────────── */
  .sign-body { padding: 3.5rem 0 5rem; background: var(--ivory); }
  .sign-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: start;
  }

  /* ── Form fields ────────────────────────────────────────── */
  .sign-form { display: flex; flex-direction: column; gap: 1.5rem; }

  .field-group { display: flex; flex-direction: column; gap: 0.4rem; }

  .field-label {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--navy);
  }
  .field-optional {
    font-size: 0.8125rem;
    color: var(--muted);
    font-weight: 400;
  }
  .field-hint {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }

  .field-input {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--navy);
    background: #fff;
    border: 1.5px solid var(--rule);
    border-radius: 3px;
    padding: 0.65rem 0.875rem;
    width: 100%;
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none;
    appearance: none;
  }
  .field-input::placeholder { color: var(--muted); opacity: 0.7; }
  .field-input:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201,146,42,0.15);
  }

  .field-textarea {
    resize: vertical;
    min-height: 100px;
    line-height: 1.6;
  }

  .field-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--slate);
    margin-top: 0.25rem;
    cursor: pointer;
  }
  .field-checkbox-label input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: var(--gold);
    cursor: pointer;
    flex-shrink: 0;
  }

  /* ── Submit + privacy ───────────────────────────────────── */
  .submit-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy);
    background: var(--gold);
    border: none;
    border-radius: 2px;
    padding: 0.875rem 1.5rem;
    cursor: pointer;
    transition: background 0.15s;
    align-self: flex-start;
  }
  .submit-btn:hover { background: var(--amber); }
  .submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .privacy-note {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }
  .privacy-note a {
    color: var(--steel);
    text-underline-offset: 3px;
  }
  .privacy-note a:hover { color: var(--gold); }

  /* ── Notices ────────────────────────────────────────────── */
  .form-notice {
    border-left: 3px solid var(--gold);
    background: var(--cream);
    padding: 1rem 1.25rem;
    border-radius: 0 3px 3px 0;
    margin-bottom: 1.5rem;
  }
  .form-notice--success { border-left-color: #1a4a2e; background: #edf7f1; }
  .notice-label { color: var(--gold); margin-bottom: 0.35rem; }
  .form-notice--success .notice-label { color: #1a4a2e; }
  .notice-text {
    font-size: 0.9375rem;
    color: var(--slate);
    line-height: 1.6;
    margin: 0;
  }

  .form-error {
    font-size: 0.875rem;
    color: #8b2020;
    margin-top: 0.25rem;
  }

  /* ── Sidebar ────────────────────────────────────────────── */
  .sign-sidebar { display: flex; flex-direction: column; gap: 1.5rem; }

  .sign-callout {
    border-left: 3px solid var(--gold);
    padding: 1.1rem 1.25rem;
    background: var(--cream);
    border-radius: 0 3px 3px 0;
  }
  .sign-callout .label {
    color: var(--gold);
    margin-bottom: 0.75rem;
    display: block;
  }
  .sign-callout ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sign-callout li {
    font-size: 0.9375rem;
    color: var(--slate);
    line-height: 1.55;
    padding-left: 1rem;
    position: relative;
  }
  .sign-callout li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--gold);
  }
  .sign-callout p {
    font-size: 0.9375rem;
    color: var(--slate);
    line-height: 1.6;
    margin: 0;
  }
  .sign-callout a {
    color: var(--steel);
    text-underline-offset: 3px;
  }
  .sign-callout a:hover { color: var(--gold); }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 760px) {
    .sign-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .submit-btn { width: 100%; text-align: center; }
  }
</style>

<script>
  const SUPABASE_URL = "https://bxisrydsueinqnwoxfqv.supabase.co";
  const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ4aXNyeWRzdWVpbnFud294ZnF2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk5Mzk4NjMsImV4cCI6MjA5NTUxNTg2M30.z-klpHW73PXs5zzKyVQ3ZqY5hHSY_nvi4PQDJ2vhnWc";

  const form = document.getElementById('sign-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formError = document.getElementById('form-error') as HTMLElement;
  const successMessage = document.getElementById('success-message') as HTMLElement;
  const formNotice = document.getElementById('form-notice') as HTMLElement;

  if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
    formNotice.style.display = 'block';
    (document.getElementById('notice-label') as HTMLElement).textContent = 'Configuration error';
    (document.getElementById('notice-text') as HTMLElement).textContent =
      'Signing is temporarily unavailable. Please try again later.';
    submitBtn.disabled = true;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.style.display = 'none';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const affiliation = (document.getElementById('affiliation') as HTMLInputElement).value.trim();
    const why = (document.getElementById('why') as HTMLTextAreaElement).value.trim();
    const shareReason = (document.getElementById('share-reason') as HTMLInputElement).checked;
    const showName = (document.getElementById('show-name') as HTMLInputElement).checked;

    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/signatories`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
          'Prefer': 'return=minimal',
        },
        body: JSON.stringify({
          full_name: name,
          email: email,
          affiliation: affiliation || null,
          why_signing: why || null,
          share_reason: shareReason,
          anonymous: !showName,
        }),
      });

      if (!response.ok) {
        let isDuplicate = response.status === 409;
        if (!isDuplicate && response.status === 400) {
          try {
            const body = await response.json();
            if (body && (body.code === '23505' || (body.message && body.message.includes('duplicate')))) {
              isDuplicate = true;
            }
          } catch (_) {}
        }
        if (isDuplicate) {
          formError.textContent = 'It looks like you\'ve already signed the Manifesto with this email address. Check the signatories page to confirm.';
          formError.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Sign the Manifesto';
          return;
        }
        throw new Error(`Server error: ${response.status}`);
      }

      form.style.display = 'none';
      successMessage.style.display = 'block';

    } catch (err) {
      formError.textContent = 'Something went wrong. Please try again.';
      formError.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign the Manifesto';
    }
  });
</script>
