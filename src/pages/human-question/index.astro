---
import BaseLayout from '../../layouts/BaseLayout.astro';

const hqSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The Human Question',
  description: 'A working almanac of artificial intelligence and human life, in ten domains and one open verdict.',
  url: 'https://nosproject.org/human-question/',
  author: { '@type': 'Person', name: 'Jason G. Troxel' },
  license: 'https://creativecommons.org/licenses/by-sa/4.0/',
};

const toc = [
  { num: '01', label: 'Technical',      slug: 'technical-demystification' },
  { num: '02', label: 'Economics',      slug: 'economics-labor-industry' },
  { num: '03', label: 'Geopolitics',    slug: 'geopolitics-national-security' },
  { num: '04', label: 'Ethics',         slug: 'ethics-society-human-impact' },
  { num: '05', label: 'Frontier',       slug: 'existential-frontier' },
  { num: '06', label: 'Regulatory',     slug: 'regulatory-legal-governance' },
  { num: '07', label: 'Safety',         slug: 'safety-security-information-integrity' },
  { num: '08', label: 'Infrastructure', slug: 'infrastructure-environment' },
  { num: '09', label: 'Science',        slug: 'science-knowledge-domains' },
  { num: '10', label: 'Faith',          slug: 'faith-identity-human-condition' },
];
---

<BaseLayout
  title="The Human Question"
  description="A working almanac of artificial intelligence and human life, in ten domains and one open verdict."
  pageSchema={hqSchema}
>
  <div class="almanac-cover">

    <div class="almanac-cover__masthead">
      <span>VOLUME I · 2026</span>
      <span>nOS · PUBLIC INTELLIGENCE PLATFORM</span>
      <span>ONGOING SURVEY</span>
    </div>

    <div class="almanac-cover__hero">

      <div class="almanac-cover__left">
        <div class="almanac-cover__eyebrow">An Almanac of</div>
        <h1 class="almanac-cover__title">
          the Human<br>
          <em>Question</em><span class="period">.</span>
        </h1>
        <p class="almanac-cover__standfirst">
          A working almanac of artificial intelligence and human life,
          in ten domains and one open verdict.
        </p>
      </div>

      <aside class="almanac-cover__toc">
        <img
          src="/assets/thq-monogram.svg"
          alt="The Human Question"
          class="almanac-cover__seal"
          width="140"
          height="140"
        />
        <div class="almanac-cover__toc-head">Contents</div>
        {toc.map(item => (
          <a href={`/human-question/${item.slug}/`} class="almanac-cover__toc-item">
            <span class="almanac-cover__toc-num">{item.num}</span>
            <span class="almanac-cover__toc-label">{item.label}</span>
            <span class="almanac-cover__toc-arrow" aria-hidden="true">›</span>
          </a>
        ))}
      </aside>

    </div>

    <div class="almanac-cover__footer">
      <span>Edited by Jason G. Troxel</span>
      <span>nosproject.org / human-question</span>
      <span>CC BY-SA 4.0</span>
    </div>

  </div>
</BaseLayout>

<style>
  /* ─── Page background ──────────────────────────────────────────── */
  :global(body) { background: var(--ivory); }

  /* ─── Cover shell ──────────────────────────────────────────────── */
  .almanac-cover {
    width: 100%;
    max-width: 1280px;
    min-height: calc(100vh - 80px);
    margin: 0 auto;
    padding: 48px 80px 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  /* ─── Masthead ─────────────────────────────────────────────────── */
  .almanac-cover__masthead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 2px solid var(--navy);
    border-bottom: 1px solid var(--navy);
    padding: 12px 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--navy);
    text-transform: uppercase;
  }

  /* ─── Hero grid ────────────────────────────────────────────────── */
  .almanac-cover__hero {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 64px;
    align-items: center;
    margin-top: 36px;
  }

  /* ─── Left: title block ────────────────────────────────────────── */
  .almanac-cover__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 18px;
    font-weight: 700;
  }

  .almanac-cover__title {
    font-family: var(--font-serif);
    font-size: clamp(64px, 8vw, 110px);
    font-weight: 700;
    color: var(--navy);
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .almanac-cover__title em {
    color: var(--gold);
    font-weight: 400;
  }

  .almanac-cover__title .period {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(80px, 10vw, 140px);
    color: var(--gold);
    margin-left: -8px;
    line-height: 0.5;
  }

  .almanac-cover__standfirst {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    color: var(--slate);
    margin: 32px 0 0;
    max-width: 520px;
    line-height: 1.55;
  }

  /* ─── Right: seal + TOC ────────────────────────────────────────── */
  .almanac-cover__toc {
    border-left: 1px solid var(--rule);
    padding-left: 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .almanac-cover__seal {
    display: block;
    margin: 0 auto 20px;
    opacity: 0.92;
  }

  .almanac-cover__toc-head {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 3px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 10px;
    font-weight: 700;
    width: 100%;
  }

  /* ─── TOC items as CTAs ────────────────────────────────────────── */
  .almanac-cover__toc-item {
    display: flex;
    gap: 10px;
    align-items: center;
    width: 100%;
    padding: 7px 8px;
    border-bottom: 1px dotted var(--rule);
    font-family: var(--font-serif);
    font-size: 14px;
    color: var(--navy);
    text-decoration: none;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.15s ease, box-shadow 0.15s ease, padding-left 0.15s ease;
    position: relative;
  }

  .almanac-cover__toc-item:hover {
    background: var(--cream);
    box-shadow: 0 2px 10px rgba(13, 27, 42, 0.1);
    padding-left: 12px;
    color: var(--navy);
  }

  .almanac-cover__toc-num {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 1.5px;
    min-width: 22px;
    flex-shrink: 0;
  }

  .almanac-cover__toc-label {
    flex: 1;
  }

  .almanac-cover__toc-arrow {
    font-size: 16px;
    color: var(--gold);
    opacity: 0;
    transition: opacity 0.15s ease, transform 0.15s ease;
    transform: translateX(-4px);
    line-height: 1;
  }

  .almanac-cover__toc-item:hover .almanac-cover__toc-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ─── Cover footer ─────────────────────────────────────────────── */
  .almanac-cover__footer {
    border-top: 1px solid var(--rule);
    padding-top: 14px;
    margin-top: 28px;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--muted);
    text-transform: uppercase;
  }

  /* ─── Responsive ───────────────────────────────────────────────── */
  @media (max-width: 880px) {
    .almanac-cover {
      padding: 32px 28px 32px;
      min-height: 0;
    }
    .almanac-cover__masthead {
      font-size: 9px;
      letter-spacing: 2px;
      flex-wrap: wrap;
      gap: 4px;
    }
    .almanac-cover__hero {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-top: 28px;
    }
    .almanac-cover__toc {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--rule);
      padding-top: 24px;
    }
    .almanac-cover__seal {
      width: 80px;
      height: 80px;
    }
    .almanac-cover__footer {
      flex-direction: column;
      gap: 6px;
    }
  }

  @media (max-width: 480px) {
    .almanac-cover { padding: 24px 20px; }
  }
</style>
