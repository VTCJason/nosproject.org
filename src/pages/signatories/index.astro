---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Fetch public signatories at build time from the public view (no email exposed)
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

let signatories: Array<{
  id: string;
  full_name: string;
  affiliation: string | null;
  why_signing: string | null;
  created_at: string;
}> = [];

let fetchError = false;

if (SUPABASE_URL && SUPABASE_ANON_KEY) {
  try {
    const endpoint = SUPABASE_URL + "/rest/v1/public_signatories?select=id,full_name,affiliation,why_signing,created_at&order=created_at.asc";
    const res = await fetch(endpoint, {
      headers: {
        apikey: SUPABASE_ANON_KEY,
        Authorization: "Bearer " + SUPABASE_ANON_KEY,
      },
    });
    if (res.ok) {
      signatories = await res.json();
    } else {
      fetchError = true;
    }
  } catch {
    fetchError = true;
  }
}

const count = signatories.length;
---

<BaseLayout
  title="Signatories"
  description="Those who have signed the nOS Manifesto."
>
  <div class="sig-hero">
    <div class="container">
      <p class="label eyebrow">Public Record</p>
      <h1 class="sig-headline">Signatories</h1>
      <p class="sig-subline">
        Those who have read the nOS Manifesto and added their names to it. Signing is an
        individual act — a public statement of agreement.
      </p>
      <p class="label sig-count">
        {count === 0 ? 'No signatures yet — be the first' : count + ' signature' + (count === 1 ? '' : 's')}
      </p>
    </div>
  </div>

  <section class="sig-body">
    <div class="container">
      {fetchError && (
        <div class="sig-notice">
          <p class="label">Could not load signatories</p>
          <p>Please try refreshing the page.</p>
        </div>
      )}

      {!fetchError && count === 0 && (
        <div class="sig-notice">
          <p class="label">No signatures yet</p>
          <p>
            Be among the first to sign. <a href="/sign/">Sign the manifesto</a>.
          </p>
        </div>
      )}

      {count > 0 && (
        <table class="sig-table" aria-label="Signatories">
          <thead>
            <tr>
              <th>Name</th>
              <th>Affiliation</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            {signatories.map(sig => (
              <tr>
                <td>{sig.full_name}</td>
                <td class="sig-affiliation">{sig.affiliation ?? '—'}</td>
                <td class="sig-date label">{sig.created_at.slice(0, 10)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </section>
</BaseLayout>
