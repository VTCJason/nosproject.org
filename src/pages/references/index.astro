---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sections = [
  {
    heading: 'Foundational AI Research',
    refs: [
      {
        id: '1',
        title: 'Placeholder reference — full reference list to be compiled',
        authors: '',
        source: '',
        year: '',
        url: '#',
      },
    ],
  },
  {
    heading: 'Economic Impact & Labor',
    refs: [
      {
        id: '2',
        title: 'Placeholder reference — full reference list to be compiled',
        authors: '',
        source: '',
        year: '',
        url: '#',
      },
    ],
  },
  {
    heading: 'Governance & Policy',
    refs: [
      {
        id: '3',
        title: 'Placeholder reference — full reference list to be compiled',
        authors: '',
        source: '',
        year: '',
        url: '#',
      },
    ],
  },
];
---

<BaseLayout
  title="References"
  description="Sources and reference material for the nOS Manifesto and The Human Question."
>
  <div class="ref-hero">
    <div class="container">
      <p class="label eyebrow">Source Material</p>
      <h1 class="ref-headline">References</h1>
      <p class="ref-subline">
        The research and sources underpinning the nOS Manifesto and The Human Question. All claims
        are traceable. Verdicts are only as strong as the evidence.
      </p>
    </div>
  </div>

  <section class="ref-body">
    <div class="container">
      <div class="ref-notice">
        <p class="label">Reference list in preparation</p>
        <p>
          Full citations are being compiled and will be published alongside the Human Question
          topic pages. Placeholder entries are shown below for structure.
        </p>
      </div>

      {
        sections.map(section => (
          <div class="ref-section">
            <h2 class="ref-section-heading">{section.heading}</h2>
            <ol class="ref-list">
              {section.refs.map(ref => (
                <li class="ref-item" id={`ref-${ref.id}`}>
                  <span class="ref-number label">[{ref.id}]</span>
                  <div class="ref-content">
                    {ref.url !== '#' ? (
                      <a href={ref.url} class="ref-title" target="_blank" rel="noopener">
                        {ref.title}
                      </a>
                    ) : (
                      <span class="ref-title ref-title--placeholder">{ref.title}</span>
                    )}
                    {ref.authors && <span class="ref-meta">{ref.authors}</span>}
                    {(ref.source || ref.year) && (
                      <span class="ref-meta ref-source">
                        {ref.source}
                        {ref.source && ref.year ? ', ' : ''}
                        {ref.year}
                      </span>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .ref-hero {
    background: var(--cream);
    padding: 3.5rem 0 3rem;
    border-bottom: 1px solid var(--rule);
  }
  .eyebrow {
    margin-bottom: 0.75rem;
  }
  .ref-headline {
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--navy);
    margin-bottom: 0.875rem;
  }
  .ref-subline {
    font-size: 1.0625rem;
    color: var(--muted);
    max-width: 58ch;
    line-height: 1.75;
  }
  .ref-body {
    padding: 3rem 0 5rem;
    max-width: 860px;
  }
  .ref-body .container {
    max-width: 860px;
  }
  .ref-notice {
    background: var(--cream);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }
  .ref-notice .label {
    margin-bottom: 0.5rem;
    color: var(--amber);
  }
  .ref-notice p {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: none;
  }
  .ref-section {
    margin-bottom: 3rem;
  }
  .ref-section-heading {
    font-size: 1.125rem;
    color: var(--navy);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .ref-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0;
  }
  .ref-item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem;
    align-items: start;
  }
  .ref-number {
    color: var(--muted);
    padding-top: 0.1rem;
  }
  .ref-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .ref-title {
    font-size: 0.9375rem;
    color: var(--navy);
    line-height: 1.55;
  }
  .ref-title--placeholder {
    color: var(--muted);
    font-style: italic;
  }
  .ref-meta {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .ref-source {
    font-style: italic;
  }
</style>
